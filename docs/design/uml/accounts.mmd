classDiagram
    User "1" --> "0..1" ClientAccount
    User "1" --> "0..1" PharmacyAccount
    User *-- Role
    ClientAccount *-- PhoneNumber
    ClientAccount *-- Location
    ClientAccount *-- SearchRadius
    ClientAccount *-- MailPreferences
    Location *-- Coordinates
    PharmacyAccount *-- PharmacyKind
    PharmacyAccount *-- Cuit
    PharmacyAccount *-- PhoneNumber
    PharmacyAccount *-- Location
    PharmacyAccount *-- OpeningHours
    OpeningHours *-- TimeSlot
    PharmacyAccount *-- DeliveryTerms
    PharmacyAccount *-- PreparationTag
    DeliveryTerms *-- DeliveryRadius
    DeliveryTerms *-- Money

    class User {
        email: str
        firstName: str
        lastName: str
        +getInitials() str
    }
    class ClientAccount {
        healthInsuranceNumber: str
        searchRadius: SearchRadius
        +updatePersonalDetails(phone, healthInsuranceNumber)
        +updateSearchPreferences(location, searchRadius)
        +updateMailPreferences(mailPreferences)
    }
    class PharmacyAccount {
        tradeName: str
        legalName: str
        technicalDirector: str
        license: str
        requestEmail: str
        website: str
        visible: bool
        +updateEstablishment(visible, kind, tradeName, legalName, cuit, technicalDirector, license)
        +updateContact(requestEmail, phone, website)
        +updateLocation(location)
        +updateOpeningHours(openingHours)
        +updateDeliveryTerms(deliveryTerms)
        +updatePreparationTags(preparationTags)
    }
    class Role {
        <<enum>>
        CUSTOMER = "customer"
        PHARMACY = "pharmacy"
    }
    class PhoneNumber {
        <<value>>
        number: str
        +AR(raw) PhoneNumber$
    }
    class Location {
        <<value>>
        address: str
        locality: str
        postalCode: str
        coordinates: Coordinates
        +create(address, locality, postalCode, coordinates) Location$
    }
    class Coordinates {
        <<value>>
        latitude: float
        longitude: float
        +create(latitude, longitude) Coordinates$
    }
    class MailPreferences {
        <<value>>
        onReply: bool
        onStatusChange: bool
        onQuoteExpiry: bool
    }
    class PharmacyKind {
        <<enum>>
        PHARMACY_WITH_LAB = "pharmacy_with_lab"
        PREPARATION_LAB = "preparation_lab"
    }
    class Cuit {
        <<value>>
        number: str
        +create(raw) Cuit$
    }
    class TimeSlot {
        <<value>>
        name: str
        opens: time
        closes: time
        +create(name, opens, closes) TimeSlot$
        +closed() bool
    }
    class OpeningHours {
        <<value>>
        slots: TimeSlot[]
    }
    class DeliveryRadius {
        <<enum>>
        KM3 = 3
        KM5 = 5
        KM10 = 10
    }
    class DeliveryTerms {
        <<value>>
        pickup: bool
        homeDelivery: bool
        radius: DeliveryRadius
        baseCost: Money
        +create(pickup, homeDelivery, radius, baseCost) DeliveryTerms$
    }
    class Money {
        <<value>>
        amount: Decimal
        currency: str
        decimal_places: int
        maxDigits: int
        rounding: str
        +create(currency, amount) Money$
        +ARS(amount) Money$
        +USD(amount) Money$
    }
    class PreparationTag {
        <<enum>>
        CAPSULES = "capsules"
        CREAMS = "creams"
        SOLUTIONS = "solutions"
        SYRUPS = "syrups"
        OVULES = "ovules"
        HORMONAL = "hormonal"
        DERMATOLOGY = "dermatology"
        VETERINARY = "veterinary"
        GLUTEN_FREE = "gluten_free"
    }
    class SearchRadius {
        <<enum>>
        KM1 = 1
        KM3 = 3
        KM5 = 5
        KM10 = 10
    }

    classDef model fill:#FFE86D,stroke:#A28E26,color:#574900
    class User:::model
    class ClientAccount:::model
    class PharmacyAccount:::model
    class Role:::model
    class SearchRadius:::model
    class DeliveryRadius:::model
    class PhoneNumber:::model
    class Location:::model
    class Coordinates:::model
    class MailPreferences:::model
    class PharmacyKind:::model
    class Cuit:::model
    class TimeSlot:::model
    class OpeningHours:::model
    class DeliveryTerms:::model
    class Money:::model
    class PreparationTag:::model
