classDiagram
    User "1" --> "0..1" ClientAccount
    User "1" --> "0..1" PharmacyAccount
    PharmacyAccount "0..*" --> "1" Pharmacy
    User *-- Role
    ClientAccount *-- PhoneNumber
    ClientAccount *-- Location
    ClientAccount *-- SearchRadius
    ClientAccount *-- MailPreferences
    Location *-- Coordinates
    Pharmacy *-- PharmacyKind
    Pharmacy *-- PhoneNumber
    Pharmacy *-- Location
    Pharmacy *-- OpeningHours
    OpeningHours *-- TimeSlot
    Pharmacy *-- DeliveryTerms
    Pharmacy *-- PreparationTag
    Pharmacy *-- PharmacyMailPreferences
    PharmacyAccount *-- Cuit
    DeliveryTerms *-- Money

    class User {
        email: str
        firstName: str
        lastName: str
        timezone: ZoneInfo
        +getInitials() str
    }
    class ClientAccount {
        healthInsuranceNumber: str
        searchRadius: SearchRadius
        +updatePersonalDetails(phone, healthInsuranceNumber)
        +updateSearchPreferences(location, searchRadius)
        +updateMailPreferences(mailPreferences)
    }
    class Pharmacy {
        tradeName: str
        requestEmail: str
        website: str
        visible: bool
        score: Decimal
        +updateEstablishment(kind, tradeName)
        +setVisibility(visible)
        +updateContactInfo(requestEmail, phone, website)
        +updateLocation(location)
        +updateOpeningHours(openingHours)
        +updateDeliveryTerms(deliveryTerms)
        +updatePreparationTags(preparationTags)
        +updateMailPreferences(mailPreferences)
    }
    class PharmacyAccount {
        legalName: str
        technicalDirector: str
        license: str
        +updateLegalInfo(legalName, cuit, technicalDirector, license)
    }
    class Role {
        <<enum>>
        CUSTOMER = "customer"
        PHARMACY = "pharmacy"
    }
    class PhoneNumber {
        <<value>>
        number: str
        +AR(raw) PhoneNumber$
    }
    class Location {
        <<value>>
        address: str
        locality: str
        postalCode: str
        coordinates: Coordinates
        +create(address, locality, postalCode, coordinates) Location$
    }
    class Coordinates {
        <<value>>
        latitude: float
        longitude: float
        +create(latitude, longitude) Coordinates$
    }
    class MailPreferences {
        <<value>>
        onReply: bool
        onStatusChange: bool
    }
    class PharmacyMailPreferences {
        <<value>>
        onReply: bool
        onQuoteStatus: bool
        +default() dict$
    }
    class PharmacyKind {
        <<enum>>
        PHARMACY_WITH_LAB = "pharmacy_with_lab"
        PREPARATION_LAB = "preparation_lab"
    }
    class Cuit {
        <<value>>
        number: str
        +create(raw) Cuit$
    }
    class TimeSlot {
        <<value>>
        name: str
        opens: time
        closes: time
        +create(name, opens, closes) TimeSlot$
        +closed() bool
    }
    class OpeningHours {
        <<value>>
        slots: TimeSlot[]
        +create(slots) OpeningHours$
    }
    class DeliveryTerms {
        <<value>>
        pickup: bool
        homeDelivery: bool | None
        baseCost: Money
        +create(pickup, homeDelivery, baseCost) DeliveryTerms$
    }
    class Money {
        <<value>>
        amount: Decimal
        currency: str
        decimal_places: int
        maxDigits: int
        rounding: str
        +create(currency, amount) Money$
        +ARS(amount) Money$
        +USD(amount) Money$
    }
    class PreparationTag {
        <<enum>>
        CAPSULES = "capsules"
        CREAMS = "creams"
        SOLUTIONS = "solutions"
        SYRUPS = "syrups"
        OVULES = "ovules"
        HORMONAL = "hormonal"
        DERMATOLOGY = "dermatology"
        VETERINARY = "veterinary"
        GLUTEN_FREE = "gluten_free"
    }
    class SearchRadius {
        <<value>>
        km: int
        minKm = 1
        maxKm = 300
        +create(km)$
    }
    class InvitationLink {
        <<value>>
        role: Role
        email: str
        nextUrl: str
        details: dict
        +__str__() str
        +from_value(invitationLink) InvitationLink$
    }

    classDef model fill:#FFE86D,stroke:#A28E26,color:#574900
    class User:::model
    class ClientAccount:::model
    class Pharmacy:::model
    class PharmacyAccount:::model
    class Role:::model
    class SearchRadius:::model
    class PhoneNumber:::model
    class Location:::model
    class Coordinates:::model
    class MailPreferences:::model
    class PharmacyMailPreferences:::model
    class PharmacyKind:::model
    class Cuit:::model
    class TimeSlot:::model
    class OpeningHours:::model
    class DeliveryTerms:::model
    class Money:::model
    class PreparationTag:::model
    class InvitationLink:::model
