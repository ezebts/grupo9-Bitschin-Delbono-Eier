classDiagram
    Order "1" *-- "0..1" PrescriptionFile
    Order "1" *-- "*" StatusEvent
    Order *-- OrderStatus
    Order *-- OrderProgress
    Order *-- Urgency
    Order *-- DeliveryPreference
    StatusEvent *-- FulfillmentStatus
    QuoteRequest "1" *-- "*" Quote
    QuoteRequest *-- QuoteRequestStatus
    Quote *-- DeliveryPreference
    Conversation "1" ..> "1" QuoteRequest
    Conversation "1" *-- "*" Message
    Message <|-- UserMessage
    Message *-- MessageSender
    UserMessage *-- MessageAuthor

    class Order {
        clientAccountId: int
        code: str
        preparationTag: str
        formula: str
        presentation: str
        note: str
        prescriptionSeal: json
        +create(clientAccountId, formula, presentation, urgency, deliveryPreference, note, preparationTag) Order$
        +attach_prescription(file)
        +remove_prescription()
        +progress() OrderProgress
        +cancel()
        +markAccepted() StatusEvent
        +advanceFulfillment(estimatedAt, today) StatusEvent
        +fulfillmentLabel(status) str
    }
    class StatusEvent {
        estimatedAt: date
        createdAt: datetime
    }
    class QuoteRequest {
        orderId: int
        pharmacyId: int
        +create(orderId, pharmacyId) QuoteRequest$
        +receiveQuote(price, readyAt, validUntil, deliveryPreference, shippingCost, message, pdf)
        +reviseQuote(price, readyAt, validUntil, deliveryPreference, shippingCost, message, pdf)
        +withdrawQuote()
        +decline()
        +rejectQuote()
        +acceptQuote(today)
        +markNotChosen()
    }
    class Quote {
        price: Money
        readyAt: datetime
        validUntil: datetime
        shippingCost: Money
        message: str
        pdf: File
    }
    class Conversation {
        title: str
        serverPublicKey: str
        serverKeyFingerprint: str
        clientNotifiedAt: datetime
        pharmacyNotifiedAt: datetime
        +create(quoteRequestId, author, text, files) Conversation$
        +sendMessage(userId, displayName, text, files)
        +sendSystemMessage(text)
    }
    class Message {
        text: str
        sentAt: datetime
    }
    class MessageSender {
        <<enum>>
        CUSTOMER = "customer"
        PHARMACY = "pharmacy"
        SYSTEM = "system"
    }
    class UserMessage {
        files: File
    }
    class PrescriptionFile {
        <<value>>
        file: File
        maxSize: int
        +create(file) PrescriptionFile$
    }
    class OrderStatus {
        <<enum>>
        CANCELLED = "cancelled"
        +fromValue(raw) OrderStatus$
    }
    class OrderProgress {
        <<enum>>
        WAITING = "waiting"
        QUOTED = "quoted"
        IN_PROGRESS = "in_progress"
        FINISHED = "finished"
    }
    class Urgency {
        <<enum>>
        AS_SOON_AS_POSSIBLE = "as_soon_as_possible"
        THIS_WEEK = "this_week"
        NO_RUSH = "no_rush"
        +fromValue(raw) Urgency$
    }
    class DeliveryPreference {
        <<enum>>
        PICKUP = "pickup"
        HOME_DELIVERY = "home_delivery"
        +fromValue(raw) DeliveryPreference$
    }
    class FulfillmentStatus {
        <<enum>>
        ACCEPTED = "accepted"
        IN_PREPARATION = "in_preparation"
        READY_FOR_PICKUP = "ready_for_pickup"
        DELIVERED = "delivered"
        +fromValue(raw) FulfillmentStatus$
    }
    class QuoteRequestStatus {
        <<enum>>
        WAITING = "waiting"
        QUOTED = "quoted"
        DECLINED = "declined"
        WITHDRAWN = "withdrawn"
        REJECTED = "rejected"
        ACCEPTED = "accepted"
        NOT_CHOSEN = "not_chosen"
        +fromValue(raw) QuoteRequestStatus$
    }
    class Money {
        <<value>>
        amount: Decimal
        currency: str
        decimal_places: int
        maxDigits: int
        rounding: str
        +create(currency, amount) Money$
        +ARS(amount) Money$
        +USD(amount) Money$
    }
    class MessageAuthor {
        <<value>>
        userId: int
        displayName: str
    }

    classDef model fill:#FFE86D,stroke:#A28E26,color:#574900
    class Order:::model
    class StatusEvent:::model
    class QuoteRequest:::model
    class Quote:::model
    class Conversation:::model
    class Message:::model
    class MessageSender:::model
    class UserMessage:::model
    class PrescriptionFile:::model
    class OrderStatus:::model
    class OrderProgress:::model
    class Urgency:::model
    class DeliveryPreference:::model
    class FulfillmentStatus:::model
    class QuoteRequestStatus:::model
    class Money:::model
    class MessageAuthor:::model
